# Sao chép thành .env và chỉnh theo máy của bạn.
# Tệp .env không được commit lên git.

# --- Ứng dụng ---
APP_DEBUG=true
APP_ALLOW_REGISTER=true
# Số lần đăng nhập sai tối đa trong cửa sổ thời gian (phút)
APP_LOGIN_MAX_ATTEMPTS=8
APP_LOGIN_WINDOW_MINUTES=15

# --- Cơ sở dữ liệu ---
# sqlite | mysql
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=mnm_db
DB_USERNAME=mnm_user
DB_PASSWORD=change_me

# --- Docker Compose (MySQL) ---
MYSQL_ROOT_PASSWORD=change_me
MYSQL_PASSWORD=change_me
